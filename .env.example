# Optional shared bearer token. Leave unset for loopback-only local development.
SKYLE_API_KEY=
SKYLE_DATA_DIR=.skyle-data
SKYLE_MAX_DOCUMENT_BYTES=15728640
SKYLE_MAX_CSV_BYTES=10485760
SKYLE_MAX_IMAGE_BYTES=10485760
SKYLE_MAX_CSV_ROWS=100000

# Optional OpenAI-compatible endpoint. Disabled unless SKYLE_LLM_ENABLED=true.
# Setting true explicitly allows prompts, retrieved passages and/or images to leave this machine.
SKYLE_LLM_ENABLED=false
SKYLE_LLM_BASE_URL=
SKYLE_LLM_API_KEY=
SKYLE_LLM_MODEL=
SKYLE_LLM_TIMEOUT_SECONDS=25
